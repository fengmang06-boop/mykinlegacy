  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "prisma": "6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
